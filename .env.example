# Copy to .env and fill in real values.
# NEVER commit .env to version control.

# Application
ENVIRONMENT=development

# Database password for a local PostgreSQL container
POSTGRES_PASSWORD=change_me

# Local checkout to investigate when a request omits repository
TARGET_REPOSITORY=/absolute/path/to/repository

# LLM provider — secret, never logged
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
# For Bedrock Mantle, export AWS_BEDROCK_API_TEST in the shell that starts the API,
# then set LLM_MODEL=nvidia.nemotron-nano-3-30b and
# LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1.

# Jira — secret, never logged
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=...

# GitHub — secret, never logged
GITHUB_TOKEN=ghp_...
